{
  "compilerOptions": {
    "baseUrl": "./",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "types": ["jest", "node"],
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "test/**/*.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
