{
  "name": "analytics-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Analytics Compiler: intent → spec → contract → code",
  "main": "dist/main/main.js",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n renderer,electron -c cyan,yellow \"npm run start:renderer\" \"npm run start:electron\"",
    "start:renderer": "ng serve --configuration development",
    "start:electron": "wait-on http://localhost:4200 && npm run build:main && npm run build:preload && electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "ng build --configuration production",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node22 --external:electron --outfile=dist/main/preload.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && ng build --dry-run",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "pdf-parse": "^1.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.50.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.8.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.analytics-platform.generator",
    "productName": "Analytics Generator",
    "directories": {
      "output": "dist/packages"
    },
    "files": [
      "dist/main/**",
      "dist/renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
